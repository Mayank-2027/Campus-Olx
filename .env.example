# Global Environment Variables Example for Campus OLX

# Environment & Server Ports
NODE_ENV=development
PORT=5000
AUTH_SERVICE_PORT=5001
PRODUCT_SERVICE_PORT=5002
CHAT_SERVICE_PORT=5003
NOTIFICATION_SERVICE_PORT=5004

# Web Client URL
CLIENT_URL=http://localhost:3000

# Microservice Target URLs (Internal Docker or Local)
AUTH_SERVICE_URL=http://localhost:5001
PRODUCT_SERVICE_URL=http://localhost:5002
CHAT_SERVICE_URL=http://localhost:5003
NOTIFICATION_SERVICE_URL=http://localhost:5004

# Database & Infrastructure URLs
MONGODB_URI=mongodb://localhost:27017/campusolx
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_URL=amqp://localhost:5672

# Security & Authentication Secrets
JWT_SECRET=your_jwt_super_secret_key_change_in_production
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
COLLEGE_DOMAIN=@ietlucknow.ac.in

# Cloudinary Storage Credentials
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Notification Transport (SMTP)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
