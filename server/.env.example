PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/campus-olx
JWT_SECRET=your_jwt_secret_key
SESSION_SECRET=your_session_secret_key

# Redis (Caching & Analytics)
# Local:  redis://127.0.0.1:6379         (no TLS)
# Cloud:  redis://... or rediss://...     (check your provider's port — non-TLS port = redis://, TLS port = rediss://)
REDIS_URL=redis://127.0.0.1:6379

# RabbitMQ (Async queues & background processing)
# Local: amqp://127.0.0.1:5672           (no TLS)
# Cloud: amqps://...@cloudamqp.com/...   (TLS — CloudAMQP uses amqps://)
RABBITMQ_URL=amqp://127.0.0.1:5672

# Cloudinary (Image upload)
CLOUDINARY_CLOUD_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret

# OAuth (Google / College Email)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
